
services:

  postgres:
    image: postgres:16
    container_name: gamersify-postgres
    restart: unless-stopped

    environment:
      POSTGRES_DB: gamersify
      POSTGRES_USER: gamersify
      POSTGRES_PASSWORD: change-this-password

    ports:
      - "5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data


  redis:
    image: redis:7-alpine
    container_name: gamersify-redis
    restart: unless-stopped

    ports:
      - "6379:6379"


volumes:
  postgres_data:
